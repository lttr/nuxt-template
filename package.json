{
  "name": "nuxt-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint:vue": "eslint .",
    "check:all": "vp check && vp run lint:vue && vp run typecheck && vp test",
    "db:generate": "drizzle-kit generate --config layers/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config layers/db/drizzle.config.ts",
    "postinstall": "nuxt prepare",
    "prepare": "vp config"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.2",
    "@vueuse/core": "^15.0.0",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.156",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@vue/test-utils": "^2.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "^1.94.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
